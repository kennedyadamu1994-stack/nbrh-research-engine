# =============================================================================
# The NBRH Research Engine — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored and must NEVER be committed. In production these same values go
# into the Vercel project's Environment Variables UI, not into any file.
#
# Nothing in this repo hardcodes a credential — every secret is read from the
# environment via lib/env.ts, which fails loudly with the missing var's name
# if it isn't set.
# =============================================================================

# --- Google Sheets service account -------------------------------------------
# From the service account JSON key file you downloaded from Google Cloud.
#   GOOGLE_SERVICE_ACCOUNT_EMAIL = the "client_email" field
#   GOOGLE_PRIVATE_KEY           = the "private_key" field, in full, including
#                                 the -----BEGIN/END PRIVATE KEY----- lines.
# Paste the private key exactly as it appears in the JSON (with the literal
# \n escape sequences) OR as a real multi-line value wrapped in double quotes.
# lib/sheets/client.ts normalises both forms.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Spreadsheet ID -------------------------------------------------------
# The long string between /d/ and /edit in the spreadsheet's URL.
#   STAGING_SPREADSHEET_ID = the "Pending Review" spreadsheet, shared with the
#                            service account email above as Editor.
# This is the ONLY spreadsheet this tool ever touches. Per decision D2
# (docs/DECISIONS.md) there is no live-spreadsheet ID — approved rows are
# copied into the live NBRH Sheets by hand.
STAGING_SPREADSHEET_ID=

# --- Auth session store (Neon Postgres) -------------------------------------
# The pooled connection string from your Neon project for THIS repo
# (separate from the Club House OS database). Starts with postgresql://
# Holds two tables (admin_users, admin_sessions), created automatically on
# first use. Run `npm run create-admin -- you@email.com "a strong password"`
# once locally with this set to create your login.
POSTGRES_URL=

# --- Anthropic API ---------------------------------------------------------
# NOT used in build step 1 (no research logic yet). Added here so the slot
# is documented. Fill it in before build step 3.
ANTHROPIC_API_KEY=
